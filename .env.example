# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# MTN Mobile Money API Configuration
# Get these from MTN MoMo Developer Portal: https://momodeveloper.mtn.com/
MTN_MOMO_SUBSCRIPTION_KEY=your_mtn_primary_subscription_key
MTN_MOMO_API_USER=your_mtn_api_user_uuid
MTN_MOMO_API_KEY=your_mtn_api_key
MTN_MOMO_ENVIRONMENT=sandbox # or 'production'
MTN_MOMO_CALLBACK_URL=https://yourdomain.com/api/payment/callback
MTN_MOMO_TARGET_ENVIRONMENT=sandbox # sandbox or mtncameroon, mtnivorycoast, etc.

# Orange Money API Configuration (for future)
ORANGE_MONEY_CLIENT_ID=your_orange_client_id
ORANGE_MONEY_CLIENT_SECRET=your_orange_client_secret
ORANGE_MONEY_MERCHANT_KEY=your_orange_merchant_key
ORANGE_MONEY_ENVIRONMENT=sandbox # or 'production'

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
